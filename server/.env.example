# Copy this file to .env, then add the URL and publishable key from Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Gemini AI shopping chatbot (server-only; never put this key in the frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: API port (defaults to 4000)
# PORT=4000
